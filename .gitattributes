# Force LF line endings in the repo for all text files
# (checkout converts to OS line endings on Windows, commit normalises back to LF)
* text=auto eol=lf

# Explicitly text files
*.jsx        text eol=lf
*.js         text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.css        text eol=lf
*.html       text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.toml       text eol=lf
*.env*       text eol=lf
.gitignore   text eol=lf
.nvmrc       text eol=lf

# Binary — never modify
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.ico        binary
*.svg        text eol=lf
*.woff       binary
*.woff2      binary
*.ttf        binary
*.wav        binary
*.mp3        binary
*.mp4        binary
